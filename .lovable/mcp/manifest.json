  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ysynlyafkhtkdureesqq.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "amigoxcel-mcp",
      "version": "0.1.0",
      "title": "AmigoXcel"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List AmigoXcel services",
        "description": "Returns AmigoXcel's four growth pillars: Talent, Technology, Training, and Media.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_company_info",
        "title": "Get AmigoXcel company info",
        "description": "Returns AmigoXcel's positioning, contact email, website, and social links.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "submit_contact",
        "title": "Submit a contact / strategy call request",
        "description": "Send a new contact submission to AmigoXcel (same as the website contact form). Use this to book a strategy call or ask about services.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Full name of the person reaching out."
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 200,
              "description": "Reply-to email address."
            },
            "phone": {
              "type": "string",
              "maxLength": 40,
              "description": "Optional phone number with country code."
            },
            "service": {
              "type": "string",
              "maxLength": 100,
              "description": "Which service they're interested in (Talent, Technology, Training, Media, or Other)."
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "What they want to discuss."
            }
          },
          "required": [
            "name",
            "email",
            "message"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
